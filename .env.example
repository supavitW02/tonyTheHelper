# Copy to .env and fill in. Never commit .env — it is gitignored.
# In production these are set with `fly secrets set`, not in fly.toml.

# Supabase → Project Settings → Database → Connection string (URI).
# Use the pooled connection (port 6543) for a serverless-ish app like this one.
DATABASE_URL=postgres://postgres:password@localhost:5432/tth?sslmode=disable

# LINE Developers → your Login channel → Basic settings → Channel ID.
# The ID token must be issued for this channel or sign-in is refused.
LINE_CHANNEL_ID=

# LINE Developers → your Login channel → LIFF → the LIFF app's ID.
# Public: it appears in the URL people open. Served to the frontend at runtime.
LINE_LIFF_ID=

# Signs session cookies. At least 32 bytes. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# Optional; defaults to 8080.
# PORT=8080
