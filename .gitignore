# Agent skills — vendored, restore with: npx skills experimental_install
.claude/skills/
.claude/settings.local.json

# Web
node_modules/

# Go
api/bin/
*.test

# The built web app, embedded into the Go binary at build time (ADR-0003).
# The directory itself must exist for go:embed to compile, hence the .gitkeep.
api/static/*
!api/static/.gitkeep

# Secrets and local env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/
